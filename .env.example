# ─── LLM ──────────────────────────────────────────────
# Groq — gratuito, recomendado (console.groq.com)
GROQ_API_KEY=gsk_...

# Anthropic Claude — recomendado para chat principal (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — opcional, usado como fallback no LiteLLM
OPENAI_API_KEY=sk-...

# ─── EMBEDDINGS ───────────────────────────────────────
# Jina AI — gratuito (jina.ai)
JINA_API_KEY=jina_...

# ─── LITELLM PROXY ────────────────────────────────────
LITELLM_MASTER_KEY=sk-rayzen-qualquercoisa
LITELLM_PORT=4100
LITELLM_BASE_URL=http://localhost:4100/v1

# ─── LANGFUSE (observabilidade LLM) ──────────────────
# Crie as chaves em http://localhost:3200 após subir o docker compose
LANGFUSE_NEXTAUTH_SECRET=gere-com-openssl-rand-hex-32
LANGFUSE_SALT=gere-com-openssl-rand-hex-16
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ─── BANCO DE DADOS ───────────────────────────────────
# Usado pela API (referencia localhost)
POSTGRES_PASSWORD=senha
DATABASE_URL=postgresql://rayzen:senha@localhost:55432/rayzen_ai
LITELLM_DATABASE_URL=postgresql://rayzen:senha@postgres:5432/rayzen_ai

# ─── REDIS ────────────────────────────────────────────
REDIS_URL=redis://localhost:56379

# ─── AUTENTICAÇÃO ─────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=gere-com-openssl-rand-hex-32
JWT_AGENT_EXPIRY=30d

# Senha de acesso ao painel web
# Para hash seguro: gere com argon2 e coloque o hash aqui ($argon2id$...)
# Se usar hash argon2, defina ALLOW_PLAINTEXT_ADMIN_PASSWORD=false
ADMIN_PASSWORD=suasenha
ALLOW_PLAINTEXT_ADMIN_PASSWORD=true

# ─── PC AGENT ─────────────────────────────────────────
AGENT_POLL_INTERVAL_MS=3000
AGENT_API_URL=http://localhost:3101
AGENT_TOKEN=gere-um-token-aqui
# desktop | server — separa ações do PC de trabalho e da VPS
AGENT_ROLE=desktop

# ─── MCP HTTP (Claude Desktop) ────────────────────────
# Token que o Claude Desktop deve enviar para autenticar
# Gere com: openssl rand -hex 32
MCP_TOKEN=gere-com-openssl-rand-hex-32
# projectId padrão quando o Claude Desktop não informa um
MCP_PROJECT_ID=
# Token de LEITURA compartilhado (as 9 ferramentas de consulta, nenhuma de escrita) —
# vazio = nenhum token de leitura existe. Vago de propósito: veja MCP_TOKEN_<NOME> abaixo
# para um consumidor que precise de identidade e revogação próprias (Fase 8 do plano de
# execução tipada). Gere com: openssl rand -hex 32
MCP_READONLY_TOKEN=
# Token de leitura POR CONSUMIDOR — mesmo escopo do MCP_READONLY_TOKEN, mas nomeado no log
# de acesso e revogável sozinho (apagar esta linha não afeta outro consumidor). Um
# consumidor novo é uma variável MCP_TOKEN_<NOME> nova aqui E em docker-compose.yml.
MCP_TOKEN_HERMES=

# ─── WEBHOOK GITHUB → BUILD AUTOMÁTICO ─────────────────
# Secret configurado no GitHub (Settings → Webhooks), valida X-Hub-Signature-256
# Gere com: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=gere-com-openssl-rand-hex-32
# Host SSH (chave dedicada, forced-command) que executa git pull + docker compose build
WEBHOOK_DEPLOY_HOST=rayzen@servidor-local
# Caminho da chave privada dedicada montada no container mcp-http (somente esse uso)
WEBHOOK_DEPLOY_KEY=/run/secrets/webhook_deploy_key

# ─── APP ──────────────────────────────────────────────
NODE_ENV=development
API_PORT=3101
WEB_PORT=3100

# URL pública da API — usada pelo Next.js no browser
# Local:      http://localhost:3101
# Produção:   http://<IP_DA_VPS>:3101
NEXT_PUBLIC_API_URL=http://localhost:3101

# ─── DECK (/deck) ─────────────────────────────────────
# Vídeos de fundo da apresentação, hospedados no Mux. Sem estas variáveis o código
# cai em playbackIds fixos, e em 2026-08-20 **4 dos 5 respondiam 404** (só o primeiro
# slide ainda toca). Slide sem vídeo válido exibe um gradiente — o deck segue legível.
NEXT_PUBLIC_MUX_PLAYBACK_ID_1=
NEXT_PUBLIC_MUX_PLAYBACK_ID_2=
NEXT_PUBLIC_MUX_PLAYBACK_ID_3=
NEXT_PUBLIC_MUX_PLAYBACK_ID_4=
NEXT_PUBLIC_MUX_PLAYBACK_ID_5=

# ─── EVIDÊNCIAS ───────────────────────────────────────
# Onde ficam os prints (upload manual + jarvis:screenshot). Sem isto o padrão é
# `<cwd>/storage/evidence` — o que só coincide com o bind mount do compose
# (/app/storage/evidence) porque o WorkingDir do container é /app. Explicitar tira
# a dependência dessa coincidência: se o cwd mudar, os arquivos vão para um caminho
# efêmero e somem no próximo `docker compose up`.
EVIDENCE_DIR=

# ─── CORS ─────────────────────────────────────────────
# Lista separada por vírgula de origens permitidas
# Local:     http://localhost:3100
# Produção:  http://<IP_DA_VPS>:3100,https://<SEU_DOMINIO>
CORS_ORIGINS=http://localhost:3100

# ─── TELEGRAM SUPERVISOR ──────────────────────────────
# Token do bot criado via BotFather (t.me/botfather)
TELEGRAM_BOT_TOKEN=
# Seu chat ID (use @userinfobot para descobrir)
TELEGRAM_CHAT_ID=
# IP público da VPS — usado para gerar URLs de preview
VPS_PUBLIC_IP=
