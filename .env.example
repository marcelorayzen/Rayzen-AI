# ─── LLM ──────────────────────────────────────────────
# Groq — gratuito, recomendado (console.groq.com)
GROQ_API_KEY=gsk_...

# Anthropic Claude — recomendado para chat principal (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — opcional, usado como fallback no LiteLLM
OPENAI_API_KEY=sk-...

# ─── EMBEDDINGS ───────────────────────────────────────
# Jina AI — gratuito (jina.ai)
JINA_API_KEY=jina_...

# ─── LITELLM PROXY ────────────────────────────────────
LITELLM_MASTER_KEY=sk-rayzen-qualquercoisa
LITELLM_PORT=4100
LITELLM_BASE_URL=http://localhost:4100/v1

# ─── BANCO DE DADOS ───────────────────────────────────
# Usado pela API (referencia localhost)
POSTGRES_PASSWORD=senha
DATABASE_URL=postgresql://rayzen:senha@localhost:55432/rayzen_ai
LITELLM_DATABASE_URL=postgresql://rayzen:senha@postgres:5432/rayzen_ai

# ─── REDIS ────────────────────────────────────────────
REDIS_URL=redis://localhost:56379

# ─── AUTENTICAÇÃO ─────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=gere-com-openssl-rand-hex-32
JWT_AGENT_EXPIRY=30d

# Senha de acesso ao painel web
# Para hash seguro: gere com argon2 e coloque o hash aqui ($argon2id$...)
# Se usar hash argon2, defina ALLOW_PLAINTEXT_ADMIN_PASSWORD=false
ADMIN_PASSWORD=suasenha
ALLOW_PLAINTEXT_ADMIN_PASSWORD=true

# ─── PC AGENT ─────────────────────────────────────────
AGENT_POLL_INTERVAL_MS=3000
AGENT_API_URL=http://localhost:3101
AGENT_TOKEN=gere-um-token-aqui
# desktop | server — separa ações do PC de trabalho e da VPS
AGENT_ROLE=desktop

# ─── MCP HTTP (Claude Desktop) ────────────────────────
# Token que o Claude Desktop deve enviar para autenticar
# Gere com: openssl rand -hex 32
MCP_TOKEN=gere-com-openssl-rand-hex-32
# projectId padrão quando o Claude Desktop não informa um
MCP_PROJECT_ID=

# ─── WEBHOOK GITHUB → BUILD AUTOMÁTICO ─────────────────
# Secret configurado no GitHub (Settings → Webhooks), valida X-Hub-Signature-256
# Gere com: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=gere-com-openssl-rand-hex-32
# Host SSH (chave dedicada, forced-command) que executa git pull + docker compose build
WEBHOOK_DEPLOY_HOST=rayzen@192.168.0.175
# Caminho da chave privada dedicada montada no container mcp-http (somente esse uso)
WEBHOOK_DEPLOY_KEY=/run/secrets/webhook_deploy_key

# ─── APP ──────────────────────────────────────────────
NODE_ENV=development
API_PORT=3101
WEB_PORT=3100

# URL pública da API — usada pelo Next.js no browser
# Local:      http://localhost:3101
# Produção:   http://<IP_DA_VPS>:3101
NEXT_PUBLIC_API_URL=http://localhost:3101

# ─── CORS ─────────────────────────────────────────────
# Lista separada por vírgula de origens permitidas
# Local:     http://localhost:3100
# Produção:  http://<IP_DA_VPS>:3100,https://<SEU_DOMINIO>
CORS_ORIGINS=http://localhost:3100

# ─── TELEGRAM SUPERVISOR ──────────────────────────────
# Token do bot criado via BotFather (t.me/botfather)
TELEGRAM_BOT_TOKEN=
# Seu chat ID (use @userinfobot para descobrir)
TELEGRAM_CHAT_ID=
# IP público da VPS — usado para gerar URLs de preview
VPS_PUBLIC_IP=
