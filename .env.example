# ─── LLM ──────────────────────────────────────────────
# Groq — gratuito, recomendado (console.groq.com)
GROQ_API_KEY=gsk_...

# Anthropic Claude — recomendado para chat principal (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — opcional, usado como fallback no LiteLLM
OPENAI_API_KEY=sk-...

# ─── EMBEDDINGS ───────────────────────────────────────
# Jina AI — gratuito (jina.ai)
JINA_API_KEY=jina_...

# ─── LITELLM PROXY ────────────────────────────────────
LITELLM_MASTER_KEY=sk-rayzen-qualquercoisa
LITELLM_PORT=4100
LITELLM_BASE_URL=http://localhost:4100/v1

# ─── BANCO DE DADOS ───────────────────────────────────
# Usado pela API (referencia localhost)
POSTGRES_PASSWORD=senha
DATABASE_URL=postgresql://rayzen:senha@localhost:55432/rayzen_app
LITELLM_DATABASE_URL=postgresql://rayzen:senha@postgres:5432/rayzen_ai

# ─── REDIS ────────────────────────────────────────────
REDIS_URL=redis://localhost:56379

# ─── AUTENTICAÇÃO ─────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=gere-com-openssl-rand-hex-32
JWT_AGENT_EXPIRY=30d

# Senha de acesso ao painel web
ADMIN_PASSWORD=suasenha

# ─── PC AGENT ─────────────────────────────────────────
AGENT_POLL_INTERVAL_MS=3000
AGENT_API_URL=http://localhost:3101
AGENT_TOKEN=gere-um-token-aqui
# notebook | desktop — controla ações exclusivas de cada máquina (ex: restart_api só no notebook)
AGENT_ROLE=notebook

# ─── APP ──────────────────────────────────────────────
NODE_ENV=development
API_PORT=3101
WEB_PORT=3100
NEXT_PUBLIC_API_URL=http://localhost:3101
