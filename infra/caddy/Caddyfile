http://rayzen.com.br {
	handle /mcp* {
		reverse_proxy mcp-http:3102
	}
	handle /oauth/* {
		reverse_proxy mcp-http:3102
	}
	handle /.well-known/* {
		reverse_proxy mcp-http:3102
	}
	handle /webhook/* {
		reverse_proxy mcp-http:3102
	}
	handle {
		reverse_proxy web:3000
	}
}

# ── HUB (Hermes) ──────────────────────────────────────────────────────────────
#
# O backend exige autenticacao por construcao: `hermes serve --host 0.0.0.0` RECUSA subir sem
# provedor registrado (medido em 17/09), e a senha vem por ambiente a partir do `.env`. Entao este
# vhost nao e a unica coisa entre a internet e o HUB -- e nao deve ser.
#
# O `hermes` resolve pelo nome na rede `rayzen-ai_default`: o compose dele e separado e entra
# nessa rede como `external`.
http://hub.rayzen.com.br {
	reverse_proxy hermes:9119
}

http://api.rayzen.com.br {
	handle /ws {
		reverse_proxy api-v2:3104
	}
	handle /v2/* {
		reverse_proxy api-v2:3002
	}
	handle {
		reverse_proxy api:3001
	}
}

:80 {
	handle /preview/* {
		uri strip_prefix /preview
		file_server {
			root /srv/previews
		}
	}
}
