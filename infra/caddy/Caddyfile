http://rayzen.com.br {
	handle /mcp* {
		reverse_proxy mcp-http:3102
	}
	handle /oauth/* {
		reverse_proxy mcp-http:3102
	}
	handle /.well-known/* {
		reverse_proxy mcp-http:3102
	}
	handle /webhook/* {
		reverse_proxy mcp-http:3102
	}
	handle {
		reverse_proxy web:3000
	}
}

http://api.rayzen.com.br {
	handle /ws {
		reverse_proxy api-v2:3104
	}
	handle /v2/* {
		reverse_proxy api-v2:3002
	}
	handle {
		reverse_proxy api:3001
	}
}

:80 {
	handle /preview/* {
		uri strip_prefix /preview
		file_server {
			root /srv/previews
		}
	}
}
