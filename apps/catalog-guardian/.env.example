# Banco isolado do Catalog Guardian — nunca aponta pro Postgres do Rayzen
DATABASE_URL=postgresql://catalog_guardian:catalog_guardian_dev@localhost:15432/catalog_guardian

REDIS_HOST=localhost
REDIS_PORT=16379

# Qual CatalogAdapter usar — "openmetadata" (default) ou "unity_catalog".
# Fase 6 do roadmap: trocar de catálogo fonte é só isso, nenhuma recompilação.
CATALOG_SOURCE=openmetadata

# Sandbox OpenMetadata — ver README.md "Sandbox OpenMetadata"
OPENMETADATA_URL=http://localhost:8585/api
OPENMETADATA_TOKEN=

# Unity Catalog OSS — ver README.md § Roadmap Fase 6. Sem token por padrão
# (servidor local via docker compose não exige auth).
UNITYCATALOG_URL=http://localhost:8080/api/2.1/unity-catalog
UNITYCATALOG_TOKEN=

# Frequência do job de sync (ms). Default: 15 min
CATALOG_SYNC_INTERVAL_MS=900000

# Sempre via LiteLLM — nunca apontar direto pra OpenAI/Groq/Anthropic
LITELLM_URL=http://localhost:4100
LITELLM_API_KEY=
LITELLM_MODEL=gpt-4o

PORT=4001
