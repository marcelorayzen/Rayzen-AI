# Chave de API exigida via "Authorization: Bearer <chave>" em toda rota
# (exceto /ping). Sem valor aqui = servidor recusa TODA request com 401 —
# fail-closed por padrão, gere um valor real antes de subir em produção.
CATALOG_GUARDIAN_API_KEY=

# Secret pra verificar o JWT de identidade do usuário de negócio em /query
# (header X-Identity-Token, claim "sub" = userId) — assinado pelo BACKEND DO
# CLIENTE, que já autentica o usuário final no próprio login. Este servidor
# só verifica, nunca emite. Sem valor aqui = servidor recusa subir (ver
# src/auth/identity-jwt.module.ts). Diferente de CATALOG_GUARDIAN_API_KEY:
# aquela chave é "quem pode chamar a API", esta é "quem a API acredita que
# o chamador está representando".
CATALOG_GUARDIAN_IDENTITY_JWT_SECRET=

# Banco isolado do Catalog Guardian — nunca aponta pro Postgres do Rayzen
DATABASE_URL=postgresql://catalog_guardian:catalog_guardian_dev@localhost:15432/catalog_guardian

REDIS_HOST=localhost
REDIS_PORT=16379

# Qual CatalogAdapter usar — "openmetadata" (default) ou "unity_catalog".
# Fase 6 do roadmap: trocar de catálogo fonte é só isso, nenhuma recompilação.
CATALOG_SOURCE=openmetadata

# Sandbox OpenMetadata — ver README.md "Sandbox OpenMetadata"
OPENMETADATA_URL=http://localhost:8585/api
OPENMETADATA_TOKEN=

# Unity Catalog OSS — ver README.md § Roadmap Fase 6. Sem token por padrão
# (servidor local via docker compose não exige auth).
UNITYCATALOG_URL=http://localhost:8080/api/2.1/unity-catalog
UNITYCATALOG_TOKEN=

# Frequência do job de sync (ms). Default: 15 min
CATALOG_SYNC_INTERVAL_MS=900000

# Backlog "busca substring" fechado — embedding de nome/descrição de
# ativo/termo, calculado no sync, usado pra busca semântica em /query no
# lugar de casar palavra solta. Chamado direto na Jina API (não via LiteLLM
# — mesmo padrão de apps/api/src/modules/memory). Sem chave aqui, a busca
# semântica falha e o QueryService cai pro substring como fallback (ver
# EmbeddingService/QueryService.findRelevantAssets) — degrada, não quebra.
# Requer Postgres com a extensão pgvector (ver docker-compose.yml, imagem
# pgvector/pgvector:pg16).
JINA_API_KEY=

# Sempre via LiteLLM — nunca apontar direto pra OpenAI/Groq/Anthropic
LITELLM_URL=http://localhost:4100
LITELLM_API_KEY=
LITELLM_MODEL=gpt-4o

PORT=4001
