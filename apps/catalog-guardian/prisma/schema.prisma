generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma-client-catalog-guardian"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// Banco isolado — nunca aponta pro Postgres do Rayzen (public/v2). O Catalog
// Guardian precisa ser deployável sozinho na infra do cliente.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Catálogo sincronizado (espelho local do catálogo fonte) ──────────────────

model CatalogAsset {
  id          String   @id @default(uuid())
  externalId  String   @map("external_id") // id no catálogo fonte (ex: fully qualified name no OMD)
  source      String   // "openmetadata" | "dataplex" | "unity_catalog"
  name        String
  description String?
  owner       String?
  domain      String?  // domínio de negócio (vendas, financeiro, rh...) usado no isolamento de permissão
  sensitivity String   @default("internal") // public | internal | confidential | restricted
  containsPII Boolean  @default(false) @map("contains_pii")
  piiFields   Json?    @map("pii_fields") // string[]
  tags        Json?    // string[] — tags/classifications originais do catálogo fonte
  syncedAt    DateTime @map("synced_at") // reescrito a cada sync (15min) — NÃO representa "há quanto tempo existe"
  // Setado só na criação (SyncService nunca toca no update) — permite regra
  // proativa unclassified_asset calcular "há quanto tempo está sem
  // classificação" de verdade. @default(now()) cobre o backfill de linhas
  // pré-existentes na migração (ficam com "agora", não disparam a regra
  // imediatamente — conservador, aceitável).
  firstSyncedAt DateTime @default(now()) @map("first_synced_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // Backlog "busca substring" fechado: embedding de `${name} ${description}`,
  // calculado pelo SyncService só quando esses campos mudam (não em todo
  // sync). Unsupported() porque o Prisma Client não gera CRUD tipado pra
  // pgvector — leitura/escrita via $queryRaw/$executeRaw (ver
  // EmbeddingService), mesmo padrão do Document.embedding em apps/api.
  embedding   Unsupported("vector(1024)")?

  lineageFrom CatalogLineageEdge[] @relation("LineageTarget")
  lineageTo   CatalogLineageEdge[] @relation("LineageSource")

  @@unique([source, externalId])
  @@index([domain])
  @@map("catalog_assets")
}

// Termos de glossário — metadado conceitual/definicional (o que "PMR" ou
// "churn" significam), distinto de CatalogAsset (o quê/onde os dados
// vivem). Sem `domain`/`sensitivity`/PII de propósito: uma definição de
// termo de negócio não é conteúdo restrito por domínio (mesma lógica de
// getDomainOwner() em ownership — ver QueryService.askOwnership() e
// findRelevantGlossaryTerms()), nunca passa pelo PermissionGuardService.
model CatalogGlossaryTerm {
  id          String   @id @default(uuid())
  externalId  String   @map("external_id") // fqn do termo no catálogo fonte (ex: "termos_de_negocio.churn")
  source      String
  name        String
  displayName String?  @map("display_name")
  description String?
  syncedAt    DateTime @map("synced_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // Embedding de `${name} ${displayName} ${description}` — mesmo mecanismo
  // de CatalogAsset.embedding, ver comentário lá.
  embedding   Unsupported("vector(1024)")?

  @@unique([source, externalId])
  @@map("catalog_glossary_terms")
}

model CatalogLineageEdge {
  id        String   @id @default(uuid())
  sourceId  String   @map("source_id")
  targetId  String   @map("target_id")
  transform String?
  createdAt DateTime @default(now()) @map("created_at")

  source CatalogAsset @relation("LineageSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target CatalogAsset @relation("LineageTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@map("catalog_lineage_edges")
}

// ─── Query pipeline (o "agente") ───────────────────────────────────────────────

model QueryAudit {
  id                      String   @id @default(uuid())
  userId                  String   @map("user_id")
  profile                 String   // perfil de acesso usado (geral | financeiro | rh | steward...)
  question                String
  answer                  String
  restrictedFieldsOmitted Json?    @map("restricted_fields_omitted") // quais campos foram redigidos e por quê
  citedAssets             Json?    @map("cited_assets") // string[] — ativos citados como fonte
  riskScore               Int      @map("risk_score")
  riskLevel               String   @map("risk_level") // low | medium | high | critical
  gateRequired            Boolean  @default(false) @map("gate_required")
  gateId                  String?  @map("gate_id")
  createdAt               DateTime @default(now()) @map("created_at")

  flags QueryAuditFlag[]

  @@index([userId])
  @@index([createdAt])
  @@map("query_audits")
}

// Triagem humana (steward sinaliza uma resposta como incorreta) — tabela
// separada de propósito. QueryAudit é append-only por design (comentário em
// query-audit.service.ts); flag/resolve são updates de verdade e não podem
// morar lá. O registro do que de fato aconteceu (question/answer/riskScore)
// continua imutável; só o ciclo de vida da triagem é mutável, aqui.
model QueryAuditFlag {
  id           String    @id @default(uuid())
  queryAuditId String    @map("query_audit_id")
  reason       String
  flaggedAt    DateTime  @default(now()) @map("flagged_at")
  resolvedAt   DateTime? @map("resolved_at")

  queryAudit QueryAudit @relation(fields: [queryAuditId], references: [id], onDelete: Cascade)

  @@index([queryAuditId])
  @@index([resolvedAt])
  @@map("query_audit_flags")
}

// Gate de revisão — equivalente ao ApprovalGate do Rayzen, mas reimplementado
// aqui (sem import cross-app) já que o app precisa rodar isolado na infra do cliente.
model ReviewGate {
  id          String    @id @default(uuid())
  type        String    // "high_risk_answer" | "permission_ambiguous"
  description String
  context     Json      @default("{}")
  status      String    @default("pending") // pending | approved | rejected | expired
  createdBy   String?   @map("created_by")
  decidedBy   String?   @map("decided_by")
  decidedAt   DateTime? @map("decided_at")
  comment     String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@map("review_gates")
}

// ─── Motor proativo (Fase 4) ────────────────────────────────────────────────────

model CatalogRecommendation {
  id          String    @id @default(uuid())
  type        String    // unclassified_asset | orphan_owner | low_confidence_pattern | permission_drift | flagged_unresolved
  title       String
  description String
  priority    String    // high | medium | low
  action      String?
  computedAt  DateTime  @map("computed_at")
  dismissedAt DateTime? @map("dismissed_at")
  // Backlog "dismiss() não-sticky" (Fase 4): chave estável por instância
  // (ex. "unclassified_asset:svc.db.schema.clientes"), só preenchida pelos
  // tipos calculados em CatalogProactiveService.compute() — permission_drift
  // (escrito pelo SyncService) continua null, fora deste mecanismo de novo.
  // Permite compute() fazer upsert por instância em vez de apagar/recriar
  // tudo a cada ciclo, preservando dismissedAt de uma recomendação já vista.
  dedupeKey   String?   @unique @map("dedupe_key")

  @@index([dismissedAt])
  @@map("catalog_recommendations")
}
