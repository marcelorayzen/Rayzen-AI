generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma-client-v2"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_V2")
  schemas  = ["v2"]
}

// ─── Mission Engine ───────────────────────────────────────────────────────────

model Mission {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  title       String
  objective   String
  status      String    @default("pending") // pending | active | paused | done | failed | cancelled
  context     Json      @default("{}")       // contexto acumulado entre steps
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  specialistId String?   @map("specialist_id") // FK lógico — sem constraint para evitar cascata
  updatedAt   DateTime  @updatedAt @map("updated_at")

  steps MissionStep[]

  @@schema("v2")
  @@map("missions")
}

model MissionStep {
  id             String   @id @default(uuid())
  missionId      String   @map("mission_id")
  title          String
  status         String   @default("pending") // pending | running | done | failed | skipped
  skillId        String?  @map("skill_id")
  prompt         String?
  input          Json     @default("{}")
  output         Json?
  dependsOn      String[] @map("depends_on") // ids de steps que devem completar antes
  retries        Int      @default(0)
  executor       String   @default("ai")     // skill | ai | human
  approvalGateId String?  @map("approval_gate_id")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@schema("v2")
  @@map("mission_steps")
}

// ─── Memory Engine ────────────────────────────────────────────────────────────

// Lifecycle metadata keyed by V1 Document.id — V2 never writes to public.documents
model MemoryMeta {
  id               String    @id @default(uuid())
  v1DocumentId     String    @unique @map("v1_document_id")
  projectId        String    @map("project_id")
  memoryClass      String    @default("inbox") @map("memory_class") // inbox|working|consolidated|archive
  accessCount      Int       @default(0) @map("access_count")
  lastAccessAt     DateTime? @map("last_access_at")
  consolidatedInto String?   @map("consolidated_into") // v1DocumentId of the consolidated chunk
  memoryType       String?   @map("memory_type")        // decision|lesson|pattern|constraint|assumption
  confidence       Float?                                // 0-1
  validUntil       DateTime? @map("valid_until")
  missionId        String?   @map("mission_id")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([projectId, memoryClass])
  @@schema("v2")
  @@map("memory_meta")
}

// ─── Vault Engine ─────────────────────────────────────────────────────────────

model VaultAccessLog {
  id          String   @id @default(uuid())
  projectSlug String   @map("project_slug")
  key         String
  accessor    String   @default("api")  // skill-engine | mission-engine | api | cli
  missionId   String?  @map("mission_id")
  stepId      String?  @map("step_id")
  accessedAt  DateTime @default(now()) @map("accessed_at")

  @@index([projectSlug, accessedAt])
  @@schema("v2")
  @@map("vault_access_logs")
}

// ─── Knowledge Engine ─────────────────────────────────────────────────────────

model KnowledgeNode {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  type        String   // module|rule|entity|adr|flow|file|concept
  label       String
  description String?
  metadata    Json     @default("{}")
  confidence  Float    @default(1.0)             // 0-1 — diminui quando contradições detectadas
  origin      String?                             // extracted|manual|inferred|document|meeting|adr
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  outEdges KnowledgeEdge[] @relation("EdgeFrom")
  inEdges  KnowledgeEdge[] @relation("EdgeTo")

  @@index([projectId, type])
  @@index([projectId, label])
  @@schema("v2")
  @@map("knowledge_nodes")
}

model KnowledgeEdge {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  fromId    String   @map("from_id")
  toId      String   @map("to_id")
  relation  String   // impacta|depende_de|contém|pertence_a|usa|implementa
  weight    Float    @default(1.0)
  source    String   @default("extracted") // extracted|manual|inferred
  createdAt DateTime @default(now()) @map("created_at")

  from KnowledgeNode @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   KnowledgeNode @relation("EdgeTo",   fields: [toId],   references: [id], onDelete: Cascade)

  @@index([projectId, relation])
  @@index([fromId])
  @@index([toId])
  @@schema("v2")
  @@map("knowledge_edges")
}

// ─── Human Approval Gates ─────────────────────────────────────────────────────

model ApprovalGate {
  id           String    @id @default(uuid())
  projectId    String    @map("project_id")
  missionId    String?   @map("mission_id")
  stepId       String?   @map("step_id")
  type         String    // code_deploy|data_write|external_api|irreversible|high_cost|specialist_spawn
  description  String
  context      Json      @default("{}")
  status       String    @default("pending")   // pending|approved|rejected|expired
  expiresAt    DateTime  @map("expires_at")
  autoOnExpiry String    @default("reject") @map("auto_on_expiry") // reject|approve|pause
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  comment      String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([missionId, status])
  @@index([projectId, status])
  @@index([expiresAt, status])
  @@schema("v2")
  @@map("approval_gates")
}

// ─── Cost Controller ──────────────────────────────────────────────────────────

model CostRecord {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  missionId String?  @map("mission_id")
  stepId    String?  @map("step_id")
  model     String
  tokensIn  Int      @default(0) @map("tokens_in")
  tokensOut Int      @default(0) @map("tokens_out")
  costUsd   Float    @map("cost_usd")
  module    String   @default("ai-router")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@index([missionId])
  @@schema("v2")
  @@map("cost_records")
}

model CostBudget {
  id         String   @id @default(uuid())
  projectId  String   @unique @map("project_id")
  daily      Float?
  monthly    Float?
  perMission Float?   @map("per_mission")
  alertAt    Float    @default(0.8) @map("alert_at")
  blockAt    Float    @default(1.0) @map("block_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@schema("v2")
  @@map("cost_budgets")
}

// ─── Observability ────────────────────────────────────────────────────────────

model TraceSpan {
  id           String   @id @default(uuid())
  traceId      String   @map("trace_id")
  spanId       String   @unique @map("span_id")
  parentSpanId String?  @map("parent_span_id")
  service      String
  operation    String
  startedAt    DateTime @map("started_at")
  endedAt      DateTime? @map("ended_at")
  durationMs   Int?     @map("duration_ms")
  status       String   @default("ok")  // ok|error|timeout
  attributes   Json     @default("{}")
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([traceId])
  @@index([startedAt])
  @@schema("v2")
  @@map("trace_spans")
}

// ─── Guardian Engine ──────────────────────────────────────────────────────────

model GuardianReport {
  id                String    @id @default(uuid())
  projectId         String    @map("project_id")
  repoPath          String    @map("repo_path")
  changedFiles      String[]  @map("changed_files")
  impactedRoutes    Json      @default("[]") @map("impacted_routes")
  impactedModules   String[]  @map("impacted_modules")
  filesWithoutTests String[]  @map("files_without_tests")
  suggestedTests    Json      @default("[]") @map("suggested_tests")
  riskScore         Float     @map("risk_score")
  riskLevel         String    @map("risk_level")       // low|medium|high|critical
  deployRecommend   String    @map("deploy_recommend") // safe|review|block
  summary           String
  overridden        Boolean   @default(false)
  overrideReason    String?   @map("override_reason")

  // Blueprint v1.1 — campos adicionais para scoring determinístico
  filePath          String?   @map("file_path")
  module            String?
  score             Int       @default(0)              // 0-100 via RISK_SCORE_TABLE
  reason            String?
  signals           Json?                              // string[] — critérios que dispararam
  missingSpecs      Json?     @map("missing_specs")    // TestGap[]
  affectedFiles     Json?     @map("affected_files")
  requiredTests     Json?     @map("required_tests")
  recommendations   Json?
  blockingReasons   Json?     @map("blocking_reasons")
  status            String    @default("open")         // open|resolved|suppressed
  resolvedAt        DateTime? @map("resolved_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([projectId])
  @@index([createdAt])
  @@index([projectId, riskLevel])
  @@index([projectId, status])
  @@schema("v2")
  @@map("guardian_reports")
}

// ─── Discovery Engine ─────────────────────────────────────────────────────────

model DiscoverySession {
  id          String   @id @default(uuid())
  projectName String?  @map("project_name")
  status      String   @default("gathering") // gathering | ready | blueprint_ready
  messages    Json     @default("[]")
  blueprint   Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@schema("v2")
  @@map("discovery_sessions")
}

// ─── Policy Engine ────────────────────────────────────────────────────────────

model PolicyRule {
  id          String   @id @default(uuid())
  projectId   String?  @map("project_id")     // null = regra de sistema (default); valor = override por projeto
  name        String                           // memory_requires_source | code_requires_adr | deployment_requires_review | low_confidence_knowledge | synthesizer_requires_sources
  description String
  enabled     Boolean  @default(true)
  action      String   @default("warn")        // warn | block | gate
  config      Json     @default("{}")          // thresholds e condições específicas por regra
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  exceptions  PolicyException[]

  @@index([projectId, enabled])
  @@index([name])
  @@schema("v2")
  @@map("policy_rules")
}

// Exceção formal e auditável a uma violação de PolicyRule — distinta de
// simplesmente desabilitar a regra inteira (enabled=false). Escopo opcional
// (ex: missionId/stepId) limita onde a exceção vale; sem escopo, vale para
// todo o projeto até expirar/ser revogada.
model PolicyException {
  id        String    @id @default(uuid())
  ruleId    String    @map("rule_id")
  projectId String    @map("project_id")
  reason    String
  grantedBy String    @map("granted_by")
  scope     Json      @default("{}")          // { missionId?, stepId? } — vazio = projeto inteiro
  expiresAt DateTime? @map("expires_at")       // null = sem expiração
  revokedAt DateTime? @map("revoked_at")       // null = ativa
  createdAt DateTime  @default(now()) @map("created_at")

  rule      PolicyRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, projectId])
  @@schema("v2")
  @@map("policy_exceptions")
}

// ─── Skill Engine (SkillOpt) ──────────────────────────────────────────────────

model SkillAsset {
  id           String   @id @default(uuid())
  skillId      String   @unique @map("skill_id")   // matches SkillDefinition.id (e.g. jarvis:git_commit)
  name         String
  description  String
  category     String
  risk         String   @default("none")            // none | low | medium | high
  runtime      String   @default("agent-desktop")   // in-process | agent-desktop | agent-server
  version      String   @default("1.0")
  inputSchema  Json     @default("{}") @map("input_schema")
  outputSchema Json     @default("{}") @map("output_schema")
  enabled      Boolean  @default(true)
  builtIn      Boolean  @default(false) @map("built_in")  // true = sincronizado do registry estático
  tags         String[]
  owner        String?
  estimatedMs  Int?     @map("estimated_ms")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category, enabled])
  @@index([builtIn])
  @@schema("v2")
  @@map("skill_assets")
}

model SkillUsageLog {
  id         String   @id @default(uuid())
  skillId    String   @map("skill_id")
  projectId  String?  @map("project_id")
  missionId  String?  @map("mission_id")
  stepId     String?  @map("step_id")
  success    Boolean
  durationMs Int      @map("duration_ms")
  error      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([skillId, createdAt])
  @@index([projectId, createdAt])
  @@schema("v2")
  @@map("skill_usage_logs")
}

// ─── Specialist Agent Engine ──────────────────────────────────────────────────

model SpecialistAgent {
  id           String   @id @default(uuid())
  projectId    String?  @map("project_id")     // null = built-in global; value = project-scoped override
  domain       String                           // backend | qa | infra | data | devops | general
  name         String
  description  String
  systemPrompt String   @map("system_prompt")
  model        String?                          // override LLM model for this specialist
  enabled      Boolean  @default(true)
  builtIn      Boolean  @default(false) @map("built_in")
  capabilities String[]                         // tags: api_design | testing | docker | etc.
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([domain, enabled])
  @@index([builtIn])
  @@schema("v2")
  @@map("specialist_agents")
}

// ─── Project Catalog ─────────────────────────────────────────────────────────

model ProjectCatalog {
  id          String    @id @default(uuid())
  v1ProjectId String    @unique @map("v1_project_id")  // FK lógica para public.projects.id
  owner       String?
  provenance  String    @default("manual")              // manual | blueprint | discovery | import
  tags        String[]
  healthScore Float?    @map("health_score")            // 0-100 calculado externamente
  metadata    Json      @default("{}")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([provenance])
  @@index([owner])
  @@schema("v2")
  @@map("project_catalog")
}

// ─── Evolutionary Prompting ───────────────────────────────────────────────────

model Strategy {
  id           String    @id @default(uuid())
  taskType     String    @map("task_type")      // classify | summarize | generate_code | review | etc.
  generation   Int       @default(0)
  systemPrompt String    @map("system_prompt")
  tier         Int       @default(3)            // 2 | 3 | 4 (LiteLLM tier)
  temperature  Float     @default(0.2)
  contextMode  String?   @map("context_mode")
  fitnessScore Float?    @map("fitness_score")  // calculado pelo BenchmarkService
  status       String    @default("candidate")  // candidate | active | retired
  parentIds    String[]  @map("parent_ids")
  notes        String?
  promotedAt   DateTime? @map("promoted_at")
  retiredAt    DateTime? @map("retired_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([taskType, status])
  @@index([status, fitnessScore])
  @@schema("v2")
  @@map("strategies")
}

// ─── Benchmark Engine ─────────────────────────────────────────────────────────

model BenchmarkCase {
  id        String   @id @default(uuid())
  taskType  String   @map("task_type")           // classify | summarize | generate | route | etc.
  input     String                                // prompt ou texto de entrada
  expected  String                                // saída esperada (ground truth)
  source    String   @default("trace")            // trace | manual
  projectId String?  @map("project_id")
  approved  Boolean  @default(false)              // faz parte do golden set quando true
  createdAt DateTime @default(now()) @map("created_at")

  results BenchmarkResult[]

  @@index([taskType, approved])
  @@index([projectId, taskType])
  @@schema("v2")
  @@map("benchmark_cases")
}

model BenchmarkResult {
  id          String   @id @default(uuid())
  caseId      String   @map("case_id")
  strategyId  String   @map("strategy_id")       // id livre — pode ser model+prompt hash
  accuracy    Float                               // 0-1 calculado pelo avaliador LLM
  costUsd     Float    @map("cost_usd")
  latencyMs   Int      @map("latency_ms")
  fitness     Float                               // accuracy*0.7 + (1/costNorm)*0.15 + (1/latencyNorm)*0.15
  output      String                              // saída real produzida
  evaluatedAt DateTime @default(now()) @map("evaluated_at")

  case BenchmarkCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([strategyId, evaluatedAt])
  @@index([caseId])
  @@schema("v2")
  @@map("benchmark_results")
}

// ─── QA Scientist ─────────────────────────────────────────────────────────────

model Hypothesis {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  taskType        String?   @map("task_type")
  status          String    @default("active")  // active | experimenting | promoted | rejected
  title           String
  analysis        String
  report          String?
  strategyId      String?   @map("strategy_id")
  gateId          String?   @map("gate_id")
  baselineFitness Float?    @map("baseline_fitness")
  currentFitness  Float?    @map("current_fitness")
  failureCount    Int       @default(0) @map("failure_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  resolvedAt      DateTime? @map("resolved_at")

  @@index([projectId, status])
  @@index([status, createdAt])
  @@schema("v2")
  @@map("hypotheses")
}

// ─── Mission Scheduler ────────────────────────────────────────────────────────

model ScheduledMission {
  id          String    @id @default(uuid())
  missionId   String    @unique @map("mission_id")
  priority    String    @default("normal")  // critical|high|normal|low
  dependsOn   String[]  @map("depends_on")
  scheduledAt DateTime? @map("scheduled_at")
  recurrence  String?
  queuedAt    DateTime  @default(now()) @map("queued_at")
  startedAt   DateTime? @map("started_at")
  pausedAt    DateTime? @map("paused_at")
  state       Json?
  status      String    @default("queued") // queued|running|paused|done|failed

  @@index([status, priority, queuedAt])
  @@schema("v2")
  @@map("scheduled_missions")
}
