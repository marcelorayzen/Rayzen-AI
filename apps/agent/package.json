{
  "name": "agent",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@rayzen/types": "workspace:*",
    "axios": "^1.6.0",
    "chokidar": "^3.5.0",
    "dotenv": "^16.0.0",
    "node-pty": "^1.0.0",
    "open": "^10.0.0",
    "strip-ansi": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-pty": "^0.10.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^@rayzen/types$": "<rootDir>/../../packages/types/src/index.ts"
    }
  }
}
