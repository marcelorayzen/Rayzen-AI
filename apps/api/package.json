{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.json --runInBand",
    "db:migrate": "prisma migrate dev --skip-generate",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@bull-board/api": "^6.20.6",
    "@bull-board/fastify": "^6.20.6",
    "@bull-board/nestjs": "^6.20.6",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "@nestjs/bull": "^10.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/platform-fastify": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@notionhq/client": "^5.16.0",
    "@prisma/client": "^5.0.0",
    "@rayzen/types": "workspace:*",
    "argon2": "^0.44.0",
    "axios": "^1.18.1",
    "bull": "^4.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "docxtemplater": "^3.0.0",
    "fastify": "^5.9.0",
    "form-data": "^4.0.6",
    "node-fetch": "^3.3.2",
    "openai": "^4.0.0",
    "pdf-parse": "1.1.1",
    "pizzip": "^3.0.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^22.0.0",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.14",
    "@types/pdf-parse": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "prisma": "^5.0.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "modules/validation/**/*.[tj]s",
      "modules/session/**/*.[tj]s",
      "modules/voice/**/*.[tj]s",
      "modules/memory/**/*.[tj]s",
      "modules/execution/**/*.[tj]s",
      "modules/orchestrator/**/*.[tj]s",
      "modules/brain/**/*.[tj]s",
      "modules/auth/**/*.[tj]s",
      "modules/agent-bridge/**/*.[tj]s",
      "!**/*.module.ts",
      "!**/*.controller.ts",
      "!**/main.ts",
      "!**/jarvis-payload-builder.ts"
    ],
    "coverageThreshold": {
      "global": {
        "functions": 65,
        "branches": 45,
        "lines": 67
      }
    },
    "coverageDirectory": "../coverage",
    "reporters": [
      "default",
      ["jest-junit", { "outputDirectory": "./junit", "outputName": "junit.xml" }]
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@rayzen/types$": "<rootDir>/../../packages/types/src/index.ts"
    }
  }
}
