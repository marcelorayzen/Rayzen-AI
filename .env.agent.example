NODE_ENV=development

# Papel deste agente: desktop ou server
AGENT_ROLE=desktop

# URL da API central do Rayzen
AGENT_API_URL=http://<VPS_PUBLIC_IP>:3101

# Deve ser o mesmo AGENT_TOKEN configurado na VPS
AGENT_TOKEN=troque-por-um-token-forte

AGENT_POLL_INTERVAL_MS=3000


# Captura agnostica de atividade do workspace no Agent desktop.
# Complementa o hook do Claude e tambem cobre Codex, VS Code e terminal comum.
AGENT_WORKSPACE_WATCH_ENABLED=true
AGENT_WORKSPACE_WATCH_INTERVAL_MS=30000

# Opcional: caminhos raiz para procurar repositorios Git, separados por ponto e virgula.
# Se vazio, usa o diretorio atual do Agent e %USERPROFILE%\Desktop\Projects.
# AGENT_WORKSPACE_ROOTS=C:\Users\marce\Desktop\Projects;C:\Users\marce\Desktop\boost
